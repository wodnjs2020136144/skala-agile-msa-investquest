# 목 데이터 모드.
# 백엔드 작업본이 도착하기 전까지 프런트를 단독으로 돌리기 위한 스위치다.
# true  = src/mock/ 의 목 데이터 + 목 로그인
# false = 실제 API Gateway(8080) + OAuth2 로그인
VITE_USE_MOCK=true

# API Gateway (모든 요청은 게이트웨이를 통해)
VITE_API_BASE_URL=http://localhost:8080

# OAuth Authorization Server (게이트웨이 기준으로 통일)
VITE_AUTH_SERVER_URL=http://localhost:8080

# OAuth Client 정보 (auth-server와 반드시 일치)
VITE_CLIENT_ID=web-client
VITE_CLIENT_SECRET=web-secret

# OAuth Redirect URI (auth-server 설정과 반드시 동일)
VITE_REDIRECT_URI=http://localhost:3000/callback